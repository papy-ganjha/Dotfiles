#!/usr/bin/env bash
# Toggle macOS Light/Dark appearance and sync downstream tools.
#   - Ghostty and auto-dark-mode.nvim follow macOS automatically
#   - tmux config is reloaded so Catppuccin flavor re-evaluates
#   - Claude Code's theme is written to ~/.claude/settings.json (new sessions only)
set -euo pipefail

osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode'

if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
  claude_theme="dark"
else
  claude_theme="light"
fi

settings="$HOME/.claude/settings.json"
if [[ -f "$settings" ]] && command -v jq >/dev/null 2>&1; then
  tmp=$(mktemp)
  if jq --arg theme "$claude_theme" '.theme = $theme' "$settings" > "$tmp"; then
    mv "$tmp" "$settings"
  else
    rm -f "$tmp"
  fi
fi

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
fi
