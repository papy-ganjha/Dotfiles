#!/usr/bin/env bash
# Toggle macOS Light/Dark appearance and reload tmux.
# Ghostty and auto-dark-mode.nvim follow macOS automatically;
# Claude Code is set to "auto" theme (detects terminal background on its own);
# tmux config reload re-evaluates the Catppuccin flavor.
set -euo pipefail

osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode'

if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
fi
