#!/bin/bash
# Connect to the Mac Studio via mosh over the corp VPN.
#
# Asymmetric routing: the Mac Studio RECEIVES on the IP the client dialed
# (e.g. 17.192.201.28) but, with mosh-server bound to 0.0.0.0, it REPLIES from
# whatever source the kernel picks to route back to the client -- its ipsec0
# address (e.g. 17.233.28.174). mosh-client uses a connected UDP socket, so it
# only accepts replies from the IP it connected to. Therefore the client must
# connect to that route-back IP, which we detect at runtime on the server.
# (Verified with a round-trip echo: connecting to the route-back IP yields a
# reply whose source matches; connecting to the dialed SSH IP does not.)

HOST="${1:-macstud}"
SERVER_CMD="mosh-server new -i 0.0.0.0 -c 256 -l LANG=en_US.UTF-8"

# Fresh, isolated SSH for the bootstrap:
#  - ControlMaster=no / ControlPath=none : never reuse a persistent master,
#    which goes stale when the VPN roams and yields "broken pipe".
#  - ClearAllForwardings=yes : don't inherit the config's LocalForward 8791,
#    which collides ("address already in use") with a lingering session.
SSH_OPTS=(-o ProxyCommand=none -o ConnectTimeout=15
          -o ControlMaster=no -o ControlPath=none -o ClearAllForwardings=yes)

# Remote: find the source IP the server uses to route back to this SSH client,
# then start mosh-server -- same session, so the detected IP matches the route
# mosh's UDP replies will take.
remote_script='
client_ip=${SSH_CONNECTION%% *}
iface=$(route -n get "$client_ip" 2>/dev/null | awk "/interface:/ {print \$2}")
echo "RESPOND_IP=$(ifconfig "$iface" 2>/dev/null | awk "/inet /{print \$2; exit}")"
'"$SERVER_CMD"

output=$(ssh "${SSH_OPTS[@]}" "$HOST" "$remote_script" 2>/dev/null)
respond_ip=$(echo "$output" | sed -n 's/^RESPOND_IP=//p')
connect_line=$(echo "$output" | grep "MOSH CONNECT")
port=$(echo "$connect_line" | awk '{print $3}')
key=$(echo "$connect_line" | awk '{print $4}')

if [ -z "$key" ] || [ -z "$port" ] || [ -z "$respond_ip" ]; then
    echo "mosh-vpn: failed to start mosh-server or detect respond IP." >&2
    echo "$output" >&2
    exit 1
fi

# Background port-forward: remote localhost:8791 -> local 8791. mosh can't
# forward ports (terminal only), so this rides a separate SSH connection.
# autossh -f daemonizes it and keeps it alive across roaming; it persists in
# the background, independent of the mosh session. It relies on the config's
# "LocalForward 8791 localhost:8791" entry -- do NOT add ClearAllForwardings
# here (it would also wipe that forward) or a second explicit -L (duplicate
# bind). ControlMaster=no makes autossh open its own connection rather than
# reuse a stale master. Stop it later with:  pkill -f 'autossh.*macstud'
if lsof -nP -iTCP:8791 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "mosh-vpn: local 8791 already forwarded; leaving it." >&2
else
    # Clear any stuck/stale forwarder that's running but not bound (otherwise
    # each reconnect piles up another autossh instead of fixing the forward).
    pkill -f 'autossh.*macstud' 2>/dev/null && sleep 1
    if AUTOSSH_GATETIME=0 autossh -M 0 -f -N \
        -o ProxyCommand=none -o ControlMaster=no -o ControlPath=none \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
        -o ExitOnForwardFailure=yes -o ConnectTimeout=15 "$HOST"; then
        echo "mosh-vpn: forwarding local 8791 -> $HOST:8791 (background)" >&2
    else
        echo "mosh-vpn: port-forward failed to start (8791)." >&2
    fi
fi

echo "mosh-vpn: connecting to $respond_ip:$port" >&2
exec env MOSH_KEY="$key" mosh-client "$respond_ip" "$port"
